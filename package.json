{
  "name": "bare-ripgrep",
  "version": "0.0.1",
  "description": "ripgrep's search and walk crates as a native addon for Bare and Node",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.c",
    "Cargo.toml",
    "Cargo.lock",
    "src",
    "CMakeLists.txt",
    "NOTICE.md",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "build": "bare-make generate && bare-make build && bare-make install",
    "bench": "node bench/index.js",
    "format": "prettier . --write",
    "test": "npm run test:node && npm run test:bare",
    "test:node": "brittle-node test/all.mjs",
    "test:bare": "brittle-bare test/all.mjs",
    "test:generate": "brittle-make-test test/all.mjs test/*.test.js",
    "lint": "prettier . --check && lunte"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tetherto/bare-ripgrep.git"
  },
  "author": "Tether Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tetherto/bare-ripgrep/issues"
  },
  "homepage": "https://github.com/tetherto/bare-ripgrep",
  "engines": {
    "bare": ">=1.16.0"
  },
  "dependencies": {
    "require-addon": "^1.1.0"
  },
  "devDependencies": {
    "bare-abort-controller": "^1.0.0",
    "bare-compat-napi": "^1.3.5",
    "bare-fs": "^4.1.2",
    "bare-make": "^1.7.0",
    "bare-os": "^3.9.4",
    "bare-path": "^3.0.0",
    "brittle": "^4.1.0",
    "cmake-bare": "^1.8.0",
    "cmake-cargo": "^0.1.1",
    "cmake-napi": "^1.2.1",
    "lunte": "^1.8.4",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0"
  }
}
